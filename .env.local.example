# Copy this file to .env.local and fill in values
# Never commit .env.local to git

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional: Telegram alert on new form submissions (parent + coach).
# Leave blank to disable notifications. See lib/notify.ts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
