# Copy this file to .env.local and fill in values
# Never commit .env.local to git

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional: Telegram alert on new form submissions (parent + coach).
# Leave blank to disable notifications. See lib/notify.ts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Self-service article publishing (/admin).
# ADMIN_PASSWORD: the shared password the author signs in with (HTTP Basic Auth).
# POSTS_GITHUB_TOKEN: fine-grained GitHub PAT scoped to this repo with
#   "Contents: Read and write" only — used to commit new/edited posts.
# GITHUB_REPO: optional; defaults to jeremygmc1/swimkidssg.
# (Telegram + Upstash above are reused for the publish ping and rate limiting.)
ADMIN_PASSWORD=
POSTS_GITHUB_TOKEN=
GITHUB_REPO=

# Coach file uploads (Vercel Blob, private store).
SWIMKIDSSG_READ_WRITE_TOKEN=
SWIMKIDSSG_STORE_ID=
# Password to open uploaded coach files via /api/coach-file (HTTP Basic Auth).
COACH_FILES_PASSWORD=

# Rate limiting (Upstash Redis). Leave blank to disable — API routes then run
# unthrottled. Create a free database at https://console.upstash.com and copy
# its REST URL and token here (see lib/ratelimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot check on the contact + coach forms. Leave blank to
# disable. The site key is public (sent to the browser); the secret key is
# server-only. Get keys at https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
