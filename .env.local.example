# Copy this file to .env.local and fill in values
# Never commit .env.local to git

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional: Telegram alert on new form submissions (parent + coach).
# Leave blank to disable notifications. See lib/notify.ts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# On-demand /analytics command via the Telegram bot. See
# docs/telegram-analytics-snapshot.md.
# Secret token you set when registering the webhook (setWebhook secret_token);
# Telegram echoes it on every call so we can reject non-Telegram requests.
TELEGRAM_WEBHOOK_SECRET=
# The always-on snapshot worker that screenshots the Vercel dashboard.
SNAPSHOT_WORKER_URL=
# Shared secret — must equal SNAPSHOT_WORKER_SECRET on the worker.
SNAPSHOT_WORKER_SECRET=

# Coach file uploads (Vercel Blob, private store).
SWIMKIDSSG_READ_WRITE_TOKEN=
SWIMKIDSSG_STORE_ID=
# Password to open uploaded coach files via /api/coach-file (HTTP Basic Auth).
COACH_FILES_PASSWORD=

# Rate limiting (Upstash Redis). Leave blank to disable — API routes then run
# unthrottled. Create a free database at https://console.upstash.com and copy
# its REST URL and token here (see lib/ratelimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot check on the contact + coach forms. Leave blank to
# disable. The site key is public (sent to the browser); the secret key is
# server-only. Get keys at https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
