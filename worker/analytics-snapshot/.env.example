# Worker secrets. On Fly.io set these with `fly secrets set KEY=value`
# (or your host's env/secret manager). Never commit real values.

# Shared secret — must equal SNAPSHOT_WORKER_SECRET on the Vercel side.
SNAPSHOT_WORKER_SECRET=

# Same bot token as the site uses, so the worker can send the photo.
TELEGRAM_BOT_TOKEN=

# The exact Vercel Analytics URL to screenshot, e.g.
# https://vercel.com/<team>/<project>/analytics
VERCEL_ANALYTICS_URL=

# Base64 of a logged-in Playwright storageState. Produce it with:
#   npm run capture-session
VERCEL_STORAGE_STATE_B64=

# Optional overrides.
# PORT=8080
# NAV_TIMEOUT_MS=45000
# CHROMIUM_EXECUTABLE_PATH=   # only if not using the provided Docker image
